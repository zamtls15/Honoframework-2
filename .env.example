# Copy this file to .env and fill in the values.
# For local development: both Vite (portal) and the API server read .env automatically.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# Public anon key — safe to expose to the browser
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_jwt>

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Used as the redirect URL when inviting users via Supabase Auth
SITE_URL=http://localhost:3000

# ── Database (Drizzle / PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ── API server (local dev only) ───────────────────────────────────────────────
PORT=5000
